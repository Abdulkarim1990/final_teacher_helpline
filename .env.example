# =============================================================================
# GES Teacher Support Helpline - Environment Configuration
# =============================================================================
# SECURITY NOTICE: Never commit actual credentials to version control!
# Copy this file to .env and fill in your actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# All database credentials MUST be configured via environment variables.
# The application will not start without these values.

# Database host (IP address or hostname)
DB_HOST=your-database-host.example.com

# Database port (default: 3306 for MySQL/MariaDB)
DB_PORT=3306

# Database name
DB_NAME=teacher_query_7

# Database username
DB_USER=your_db_username

# Database password (use a strong, unique password)
DB_PASSWORD=your_secure_password_here

# -----------------------------------------------------------------------------
# SSL/TLS Configuration (RECOMMENDED for production)
# -----------------------------------------------------------------------------
# For secure database connections in production, provide the path to your
# CA certificate file. This enables server certificate verification.

# Path to SSL CA certificate (optional, but recommended for production)
# DB_SSL_CA_PATH=/path/to/ca-certificate.crt

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------

# Set to "true" for local development without SSL
# WARNING: Never use this setting in production!
# USE_LOCAL_DB=false

# -----------------------------------------------------------------------------
# Security Notes
# -----------------------------------------------------------------------------
# 1. Use strong, unique passwords for database access
# 2. In production, always enable SSL certificate verification
# 3. Restrict database user permissions to minimum required
# 4. Rotate credentials regularly
# 5. Monitor login_audit table for suspicious activity
# 6. Keep this file secure and never commit actual credentials
# =============================================================================
